{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos mínimos de la ventana principal",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "store:default",
    "dialog:allow-save",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "**/*.pdf" }]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://wa.me/*" }, { "url": "https://neumatmotos.com.ar/*" }, { "url": "https://ventas.fundasparamotosab.com.ar/*" }, { "url": "https://changomax.mercomaxsa.com.ar/*" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$APPDATA/**" }]
    },
    "fs:allow-read-text-file",
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$DOCUMENT/Presupuestos Motos Beto" }]
    }
  ]
}
